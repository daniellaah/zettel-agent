{
  "name": "zettel-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Ask your Zettelkasten anything: a read-only, citation-first research agent inside Obsidian.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "eval": "vitest run --config eval/vitest.config.ts --project retrieval",
    "eval:crosslingual": "EVAL_SUITE=crosslingual vitest run --config eval/vitest.config.ts --project retrieval",
    "eval:embed": "vitest run --config eval/vitest.config.ts --project embed",
    "eval:exact": "EVAL_SUITE=exact vitest run --config eval/vitest.config.ts --project retrieval",
    "eval:exact-terms": "EVAL_SUITE=exact-terms vitest run --config eval/vitest.config.ts --project retrieval",
    "eval:sweep": "vitest run --config eval/vitest.config.ts --project sweep",
    "e2e": "vitest run --config e2e/vitest.config.ts",
    "e2e:live": "E2E_LIVE=1 vitest run --config e2e/vitest.config.ts e2e/agent.e2e.ts",
    "eval:full": "node --env-file-if-exists=.env.eval.local node_modules/vitest/vitest.mjs run --config eval/vitest.config.ts --project full",
    "eval:trace-report": "vitest run --config eval/vitest.config.ts --project trace-report",
    "release:package": "node scripts/package-release.mjs",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "openai": "^7.25.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
